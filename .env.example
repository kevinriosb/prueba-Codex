# Copia este archivo como .env solo para desarrollo local. No lo subas a GitHub.
APP_ENV=development
APP_LOGIN_USERNAME=admin
# Elige una contraseña propia de 12 a 256 caracteres. No uses tu contraseña de OpenAI.
APP_LOGIN_PASSWORD=
APP_SECURE_COOKIES=false
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_DATABASE_PATH=data/agent.sqlite3
APP_SESSION_HOURS=8

# Clave de la API de OpenAI; una suscripción a ChatGPT no la sustituye.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
SERVER_TIMEZONE=America/Mexico_City

MAX_INPUT_CHARS=4000
MAX_CONTEXT_BYTES=16000
MAX_OUTPUT_TOKENS=150
MAX_AGENT_TURNS=3
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=35
TOOL_TIMEOUT_SECONDS=3
MAX_DAILY_RUNS=30
MAX_DAILY_TOKENS=250000
MAX_CONVERSATION_TURNS=20
MAX_CONVERSATIONS=30
APPROVAL_TTL_SECONDS=900

# El servidor local solo escucha en esta máquina.
HOST=127.0.0.1
PORT=8000

# Facturación: desactivada hasta configurar una clave de cifrado base64 de 32 bytes.
# Genera una nueva desde Facturación → Activar el cifrado; consulta docs/FACTURACION.md.
# Conserva la clave: cambiarla o perderla impide abrir los datos cifrados existentes.
BILLING_ENCRYPTION_KEY=
BILLING_MAX_UPLOAD_BYTES=8388608
BILLING_DOCUMENT_RETENTION_HOURS=24
BILLING_INVOICE_RETENTION_DAYS=30
BILLING_MAX_DOCUMENTS=40
BILLING_MAX_PROFILES=10
BILLING_MAX_DAILY_EXTRACTIONS=10
BILLING_MAX_DAILY_TELEGRAM_UPDATES=100
BILLING_EXTRACTION_MAX_TOKENS=1400
# Activar solo cuando quieras permitir envíos aprobados por el usuario.
BILLING_LIVE_EMAIL_ENABLED=false
BILLING_SAT_ENABLED=false
BILLING_PORTAL_INSPECTION_URLS=https://f.zetus.mx/albat
BILLING_BROWSER_ENABLED=false
# Los permisos de cada portal se confirman en Telegram; no requieren lista de dominios.
BILLING_BROWSER_WORKER_URL=http://browser:8001
BILLING_BROWSER_TOKEN_FILE=/run/browser-auth/token
BILLING_BACKGROUND_TRACKING_ENABLED=false
BILLING_TRACKING_INTERVAL_SECONDS=3600
BILLING_TRACKING_MAX_CHECKS=72
# Catálogo opcional revisado por el administrador; [] no autoriza destinatarios adicionales.
BILLING_VERIFIED_CONTACTS_JSON=[]

# OAuth de Google: Gmail API, aplicación web, ámbitos gmail.send y gmail.readonly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Telegram: webhook HTTPS y usuarios autorizados. No se configura automáticamente.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REPLY_MAX_CHARS=160
