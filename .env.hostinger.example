# Variables para Docker Compose >= 2.30; mantén los valores reales fuera de Git.
# Crea .env.hostinger con: python3 scripts/configure_hostinger.py
# Compose lee los valores literalmente (format: raw). No agregues comillas.
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=
APP_ALLOWED_HOSTS=agente.lilyapp.mx,localhost,127.0.0.1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
MAX_OUTPUT_TOKENS=150
SERVER_TIMEZONE=America/Mexico_City
# Debe conservarse junto con una copia de seguridad privada de la base de datos.
BILLING_ENCRYPTION_KEY=
BILLING_LIVE_EMAIL_ENABLED=false
BILLING_SAT_ENABLED=false
BILLING_PORTAL_INSPECTION_URLS=https://f.zetus.mx/albat
# Navegador opcional: autoriza dominios concretos con scripts/configure_browser.py.
BILLING_BROWSER_ENABLED=false
BILLING_BROWSER_ORIGINS=
BILLING_BACKGROUND_TRACKING_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REPLY_MAX_CHARS=160
